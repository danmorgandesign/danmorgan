---
// Icon / Arrow Right (Carousel Button Next), exported from Figma. Inherits colour from currentColor.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props;
---
<svg class={className} {...attrs} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <rect x="22" y="10" width="4" height="22" transform="rotate(90 22 10)" fill="currentColor"/><rect x="24" y="12" width="4" height="14" transform="rotate(135 24 12)" fill="currentColor"/><rect x="21.1716" y="9.17188" width="4" height="14" transform="rotate(45 21.1716 9.17188)" fill="currentColor"/>
</svg>
