---
// Icon / Arrow Up (Back to Top), exported from Figma. Inherits colour from currentColor.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props;
---
<svg class={className} {...attrs} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <rect x="10" y="2" width="4" height="22" fill="currentColor"/><rect x="12" width="4" height="14" transform="rotate(45 12 0)" fill="currentColor"/><rect x="9.17163" y="2.82812" width="4" height="14" transform="rotate(-45 9.17163 2.82812)" fill="currentColor"/>
</svg>
