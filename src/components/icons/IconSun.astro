---
// Icon / Sun (Figma 680:386). Built from the Figma vector data (the layer is
// hidden in Light mode, so it can't be exported). Rays use border-width-icon.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;
const { class: className, ...attrs } = Astro.props;
---
<svg class={className} {...attrs} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="5" fill="currentColor"/>
  <g stroke="currentColor" stroke-linecap="round" style="stroke-width: var(--border-width-icon)">
    <path d="M12 1.5V3.5"/>
    <path d="M12 20.5V22.5"/>
    <path d="M1.5 12H3.5"/>
    <path d="M20.5 12H22.5"/>
    <path d="M4.6 4.6L6 6"/>
    <path d="M18 18L19.4 19.4"/>
    <path d="M4.6 19.4L6 18"/>
    <path d="M18 6L19.4 4.6"/>
  </g>
</svg>
