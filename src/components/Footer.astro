---
// Site footer (Figma 406:244). Breakpoint=Mobile (stacked) below 768,
// Breakpoint=Desktop (wrapping row) from Tablet up.
import NeutralButton from './NeutralButton.astro';
---
<footer class="site-footer">
  <div class="links">
    <NeutralButton aria-label="Copy email address" data-copy-email>
      <span aria-live="polite" data-copy-email-label>Copy email address</span>
    </NeutralButton>
    <NeutralButton href="https://www.linkedin.com/in/dan-morgan-design/" target="_blank" rel="noopener">LinkedIn</NeutralButton>
  </div>
  <p class="body-sm">Dan Morgan – UX Product Designer</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-stack-lg);
    padding: var(--space-inset-lg) var(--space-page-margin);
    text-align: center;
  }

  .links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-stack-md);
  }

  @media (min-width: 768px) {
    .site-footer {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      text-align: start;
    }

    .links {
      flex-direction: row;
      gap: var(--space-inline-lg);
    }
  }
</style>

<script>
  import '../scripts/copy-email.js';
</script>
